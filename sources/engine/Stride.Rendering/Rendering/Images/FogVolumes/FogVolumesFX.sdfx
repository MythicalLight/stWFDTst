namespace Stride.Rendering.Images
{
    effect FogVolumesFX
    {
        // Use code from the shadow receiver appropriate for the light this lightshaft is rendered for
        using params FogVolumesFXKeys;
        mixin compose lightGroup = (FogVolumesFXKeys.LightGroup);

        mixin FogVolumesShader<FogVolumesFXKeys.SampleCount>;
    };
}
